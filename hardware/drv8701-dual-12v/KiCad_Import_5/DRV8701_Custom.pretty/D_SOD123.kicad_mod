(module "D_SOD123"
  (layer "F.Cu")
  (descr "SOD-123 BZT52 family 2-pin; pin1 cathode, pin2 anode; verify selected manufacturer; hand-solderable pads.")
  (attr smd)
  (fp_text reference "REF**"
    (at 0 -4.2)
    (layer "F.SilkS")
    (effects
      (font
        (size 0.7 0.7)
        (thickness 0.12)
      )
    )
  )
  (fp_text value "D_SOD123"
    (at 0 4.2)
    (layer "F.Fab")
    hide
    (effects
      (font
        (size 0.7 0.7)
        (thickness 0.12)
      )
    )
  )
  (pad "1" smd roundrect
    (at -1.65 0)
    (size 1.1 1.25)
    (layers "F.Cu" "F.Paste" "F.Mask")
    (roundrect_rratio 0.2)
  )
  (pad "2" smd roundrect
    (at 1.65 0)
    (size 1.1 1.25)
    (layers "F.Cu" "F.Paste" "F.Mask")
    (roundrect_rratio 0.2)
  )
  (fp_line
    (start -1.4 -0.9)
    (end 1.4 -0.9)
    (layer "F.Fab")
    (width 0.1)
  )
  (fp_line
    (start 1.4 -0.9)
    (end 1.4 0.9)
    (layer "F.Fab")
    (width 0.1)
  )
  (fp_line
    (start 1.4 0.9)
    (end -1.4 0.9)
    (layer "F.Fab")
    (width 0.1)
  )
  (fp_line
    (start -1.4 0.9)
    (end -1.4 -0.9)
    (layer "F.Fab")
    (width 0.1)
  )
  (fp_line
    (start -1.1 -0.9)
    (end -1.1 0.9)
    (layer "F.Fab")
    (width 0.12)
  )
  (fp_line
    (start -1.1 -1.03)
    (end 1.1 -1.03)
    (layer "F.SilkS")
    (width 0.12)
  )
  (fp_line
    (start -1.1 1.03)
    (end 1.1 1.03)
    (layer "F.SilkS")
    (width 0.12)
  )
  (fp_line
    (start -1.1 -1.3)
    (end -0.65 -1.3)
    (layer "F.SilkS")
    (width 0.12)
  )
  (fp_line
    (start -2.45 -1.25)
    (end 2.45 -1.25)
    (layer "F.CrtYd")
    (width 0.05)
  )
  (fp_line
    (start 2.45 -1.25)
    (end 2.45 1.25)
    (layer "F.CrtYd")
    (width 0.05)
  )
  (fp_line
    (start 2.45 1.25)
    (end -2.45 1.25)
    (layer "F.CrtYd")
    (width 0.05)
  )
  (fp_line
    (start -2.45 1.25)
    (end -2.45 -1.25)
    (layer "F.CrtYd")
    (width 0.05)
  )
)
