(module "AMASS_XT30UPB_M_SourceNumbering"
  (layer "F.Cu")
  (descr "AMASS XT30UPB-M vertical male. Source numbering1=positive/right,2=negative/left. Official KiCad library physical polarity retained but pad numbers reversed and origin translated to body centre. Body10.2x5.2mm,pitch5mm,drill1.8mm.")
  (fp_text reference "REF**"
    (at 0 -4.2)
    (layer "F.SilkS")
    (effects
      (font
        (size 0.7 0.7)
        (thickness 0.12)
      )
    )
  )
  (fp_text value "AMASS_XT30UPB_M_SourceNumbering"
    (at 0 4.2)
    (layer "F.Fab")
    hide
    (effects
      (font
        (size 0.7 0.7)
        (thickness 0.12)
      )
    )
  )
  (fp_line
    (start -5.1 -1.3)
    (end -3.4 -2.6)
    (layer "F.Fab")
    (width 0.1)
  )
  (fp_line
    (start -3.4 -2.6)
    (end 5.1 -2.6)
    (layer "F.Fab")
    (width 0.1)
  )
  (fp_line
    (start 5.1 -2.6)
    (end 5.1 2.6)
    (layer "F.Fab")
    (width 0.1)
  )
  (fp_line
    (start 5.1 2.6)
    (end -3.4 2.6)
    (layer "F.Fab")
    (width 0.1)
  )
  (fp_line
    (start -3.4 2.6)
    (end -5.1 1.3)
    (layer "F.Fab")
    (width 0.1)
  )
  (fp_line
    (start -5.1 1.3)
    (end -5.1 -1.3)
    (layer "F.Fab")
    (width 0.1)
  )
  (fp_line
    (start -5.21 -1.41)
    (end -3.51 -2.71)
    (layer "F.SilkS")
    (width 0.12)
  )
  (fp_line
    (start -3.51 -2.71)
    (end 5.21 -2.71)
    (layer "F.SilkS")
    (width 0.12)
  )
  (fp_line
    (start 5.21 -2.71)
    (end 5.21 2.71)
    (layer "F.SilkS")
    (width 0.12)
  )
  (fp_line
    (start 5.21 2.71)
    (end -3.51 2.71)
    (layer "F.SilkS")
    (width 0.12)
  )
  (fp_line
    (start -3.51 2.71)
    (end -5.21 1.41)
    (layer "F.SilkS")
    (width 0.12)
  )
  (fp_line
    (start -5.21 1.41)
    (end -5.21 -1.41)
    (layer "F.SilkS")
    (width 0.12)
  )
  (pad "2" thru_hole rect
    (at -2.5 0)
    (size 3 3)
    (drill 1.8)
    (layers "*.Cu" "*.Mask")
  )
  (pad "1" thru_hole circle
    (at 2.5 0)
    (size 3 3)
    (drill 1.8)
    (layers "*.Cu" "*.Mask")
  )
  (fp_text user "-"
    (at -2.5 -2.15)
    (layer "F.SilkS")
    (effects
      (font
        (size 0.7 0.7)
        (thickness .12)
      )
    )
  )
  (fp_text user "+"
    (at 2.5 -2.15)
    (layer "F.SilkS")
    (effects
      (font
        (size 0.7 0.7)
        (thickness .12)
      )
    )
  )
  (fp_line
    (start -5.6 -1.8)
    (end -3.9 -3.1)
    (layer "F.CrtYd")
    (width 0.05)
  )
  (fp_line
    (start -3.9 -3.1)
    (end 5.6 -3.1)
    (layer "F.CrtYd")
    (width 0.05)
  )
  (fp_line
    (start 5.6 -3.1)
    (end 5.6 3.1)
    (layer "F.CrtYd")
    (width 0.05)
  )
  (fp_line
    (start 5.6 3.1)
    (end -3.9 3.1)
    (layer "F.CrtYd")
    (width 0.05)
  )
  (fp_line
    (start -3.9 3.1)
    (end -5.6 1.8)
    (layer "F.CrtYd")
    (width 0.05)
  )
  (fp_line
    (start -5.6 1.8)
    (end -5.6 -1.8)
    (layer "F.CrtYd")
    (width 0.05)
  )
)
